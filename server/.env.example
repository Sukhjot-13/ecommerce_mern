# Copy to .env and fill in. Never commit real values.
PORT=8080

# MongoDB connection string with <PASSWORD> placeholder, e.g.
# mongodb+srv://<user>:<PASSWORD>@cluster0.mongodb.net/shopSphere
DATABASE=
DATABASE_PASSWORD=

# Stripe secret key (server) — required for /api/v1/payment/*
STRIPE_SECRET_KEY=

# Public base URLs used for Stripe redirects (no hardcoded LAN IPs)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080
